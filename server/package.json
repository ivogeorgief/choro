  "author": "Ivo Georgief <ivogeorgief@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivogeorgief/choro.git",
    "directory": "server"
  },
  "homepage": "https://github.com/ivogeorgief/choro#readme",
  "bugs": {
    "url": "https://github.com/ivogeorgief/choro/issues"
  },
  "type": "module",
